{
  "name": "Web Proxy",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "Web proxy",
      "onAutoForward": "notify",
      "visibility": "private"
    }
  },
  "postStartCommand": "bash scripts/dev-start.sh",
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  }
}
