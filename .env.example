# Copy this file to .env (git-ignored) and edit it.
# `npm start` loads .env automatically on Node 20.6+.

# Port and bind address. Use 0.0.0.0 so Codespaces can forward the port.
PORT=8080
HOST=0.0.0.0

# Require proxy authentication. Set BOTH to turn it on.
# Strongly recommended whenever the port is publicly reachable.
# PROXY_USER=proxyuser
# PROXY_PASS=change-me

# 1 = refuse targets on private / loopback / link-local addresses (recommended).
BLOCK_PRIVATE_TARGETS=1

# 1 = log every proxied request to stdout.
LOG_REQUESTS=1

# Limits (bytes / milliseconds).
# MAX_FETCH_BYTES=5242880
# UPSTREAM_TIMEOUT_MS=30000
# FETCH_TIMEOUT_MS=20000
